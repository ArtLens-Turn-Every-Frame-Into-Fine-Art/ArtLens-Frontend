{
	"name": "artlens",
	"main": "expo-router/entry",
	"version": "1.1.0",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"lint": "expo lint",
		"android:optimized": "npx expo run:android --variant debugOptimized",
		"install-debugOptimized-apk-x86": "adb install -r ./android/app/build/outputs/apk/debugOptimized/app-x86_64-debugOptimized.apk",
		"install-debugOptimized-apk-arm64": "adb install -r ./android/app/build/outputs/apk/debugOptimized/app-arm64-v8a-debugOptimized.apk",
		"android:release": "npx expo run:android --variant release",
		"install-release-apk-x86": "adb install -r ./android/app/build/outputs/apk/release/app-x86_64-release.apk",
		"install-release-apk-arm64": "adb install -r ./android/app/build/outputs/apk/release/app-arm64-v8a-release.apk",
		"graphtree": "node generate_graph_tree.js"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@react-native-community/slider": "5.1.2",
		"@react-navigation/bottom-tabs": "^7.4.0",
		"@react-navigation/elements": "^2.6.3",
		"@react-navigation/native": "^7.1.8",
		"@react-navigation/native-stack": "^7.3.16",
		"expo": "55",
		"expo-blur": "~55.0.8",
		"expo-build-properties": "~55.0.9",
		"expo-constants": "~55.0.7",
		"expo-file-system": "~55.0.9",
		"expo-font": "~55.0.4",
		"expo-image": "~55.0.5",
		"expo-linear-gradient": "~55.0.8",
		"expo-linking": "~55.0.7",
		"expo-media-library": "~55.0.9",
		"expo-navigation-bar": "~55.0.8",
		"expo-router": "~55.0.2",
		"expo-splash-screen": "~55.0.9",
		"expo-status-bar": "~55.0.4",
		"expo-system-ui": "~55.0.9",
		"expo-updates": "~55.0.11",
		"expo-web-browser": "~55.0.9",
		"lucide-react-native": "^0.562.0",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-native": "0.83.2",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-reanimated": "4.2.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.23.0",
		"react-native-svg": "15.15.3",
		"react-native-vision-camera": "^4.7.3",
		"react-native-web": "~0.21.0",
		"react-native-worklets": "0.7.2"
	},
	"devDependencies": {
		"@mermaid-js/mermaid-cli": "^11.12.0",
		"@types/react": "~19.2.10",
		"eslint": "^9.25.0",
		"eslint-config-expo": "~55.0.0",
		"madge": "^8.0.0",
		"typescript": "~5.9.2"
	},
	"private": true
}
