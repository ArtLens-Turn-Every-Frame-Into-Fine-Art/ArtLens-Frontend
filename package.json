{
  "name": "artlens",
  "main": "expo-router/entry",
  "version": "1.6.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "android": "npx expo run:android",
    "android:optimized": "npx expo run:android --variant debugOptimized",
    "android:release": "npx expo run:android --variant release",
    "graphtree": "node generate_graph_tree.js",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "postinstall": "node -e \"const fs = require('fs'); const path = './node_modules/react-native/tmp'; if (!fs.existsSync(path)) fs.mkdirSync(path, { recursive: true });\"",
    "test": "jest --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/slider": "5.1.2",
    "@shopify/react-native-skia": "^2.6.2",
    "expo": "~55.0.26",
    "expo-battery": "~55.0.13",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-file-system": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-media-library": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-share-intent": "^6.1.0",
    "expo-sharing": "~55.0.20",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "lucide-react-native": "^0.562.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-vision-camera": "^5.0.9",
    "react-native-vision-camera-resizer": "^5.0.9",
    "react-native-vision-camera-skia": "^5.0.9",
    "react-native-vision-camera-worklets": "^5.0.9",
    "react-native-worklets": "^0.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "react-native-logger": "^1.0.3",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.2.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite",
          "react-native-nitro-image",
          "react-native-background-actions"
        ]
      }
    },
    "install": {
      "exclude": [
        "@shopify/react-native-skia",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
